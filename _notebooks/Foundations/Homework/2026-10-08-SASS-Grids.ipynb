   "source": [
    "MCQ Grids: 4/4 | answers: A,B,C,D"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2d361f8b",
   "metadata": {},
   "source": [
    "---\n",
    "Homework"
   ]
  },
  {
   "cell_type": "raw",
   "id": "6d9a30a2",
   "metadata": {
    "vscode": {
     "languageId": "raw"
    }
   },
   "source": [
    "// Fix the HTML inside the quotes, then press Run.\n",
    "let myHTML = [\n",
    "  '<div class=\"ocs__grid ocs__grid--standard\">',\n",
    "  '  <div class=\"ocs__grid-cell ocs__grid-cell--header\">Temperature Trial (°C)</div>',\n",
    "  '  <div class=\"ocs__grid-cell\">Beaker 1: 22.4</div>',\n",
    "  '  <div class=\"ocs__grid-cell\">Beaker 2: 22.9</div>',\n",
    "  '  <div class=\"ocs__grid-cell ocs__grid-cell--accent\">Beaker 3: 31.6</div>',\n",
    "  '</div>',\n",
    "  '<div class=\"ocs__grid ocs__grid--calculator\" grid-template-columns 1fr 1fr 1fr 1fr>',\n",
    "  '  <adiv class=\"ocs__grid-cell\">7</div>',\n",
    "  '  <div class=\"ocs__grid-cell\">8</div>',\n",
    "  '  <div class=\"ocs__grid-cell\">9</div>',\n",
    "  '  <div class=\"ocs__grid-cell ocs__grid-cell--accent\">Avg</div>',\n",
    "  '</div>'\n",
    "].join('');\n",
    "\n",
    "// ---- You do not need to change anything below this line ----\n",
    "let classList = [];\n",
    "for (let found of (myHTML.match(/class=\"[^\"]*\"/g) || [])) {\n",
    "  classList = classList.concat(found.slice(7, -1).split(' ').filter(c => c !== ''));\n",
    "}\n",
    "let madeUp = classList.filter(c => !c.startsWith('ocs__') && !c.startsWith('cols-'));\n",
    "\n",
    "function line(label, ok) { return '<li>' + (ok ? 'PASS  ' : 'FIX  ') + label + '</li>'; }\n",
    "let checks = '<ul>' +\n",
    "  line('No inline style attributes', !myHTML.includes('style=')) +\n",
    "  line('No made up classes' + (madeUp.length > 0 ? ' (found: ' + madeUp.join(', ') + ')' : ''), madeUp.length === 0) +\n",
    "  line('Has an ocs__grid root', classList.includes('ocs__grid')) +\n",
    "  line('Uses the standard variant for Grid 1', classList.includes('ocs__grid--standard')) +\n",
    "  line('Uses the calculator variant for Grid 2', classList.includes('ocs__grid--calculator')) +\n",
    "  line('Every box uses ocs__grid-cell', classList.filter(c => c === 'ocs__grid-cell').length >= 8) +\n",
    "  line('Title is a header cell', classList.includes('ocs__grid-cell--header')) +\n",
    "  line('Has accent cells (outlier beaker and Avg key)', classList.filter(c => c === 'ocs__grid-cell--accent').length >= 2) +\n",
    "  '</ul>';\n",
    "\n",
    "outputElement.innerHTML = checks + myHTML;"
   ]
  }
 ],
